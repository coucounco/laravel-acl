{
    "name": "coucounco/laravel-acl",
    "description": "Access Control List for Laravel",
    "authors": [
        {
            "name": "Coucou&Co",
            "email": "dev@coucounco.ch"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1.0",
        "illuminate/auth": "^10.0",
        "illuminate/container": "^10.0",
        "illuminate/contracts": "^10.0",
        "illuminate/database": "^10.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^9"
    },
    "autoload": {
        "psr-4": {
            "coucounco\\LaravelAcl\\": "src"
        },
        "files": [
            "src/Helpers/acl.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "coucounco\\LaravelAcl\\Test\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "coucounco\\LaravelAcl\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "./vendor/phpunit/phpunit/phpunit"
    }
}
